# WarrantyEase Frontend - Environment Variables
# Copy to .env.development for local dev

# URL of the OCR backend service
VITE_OCR_BACKEND_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (optional, get from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

